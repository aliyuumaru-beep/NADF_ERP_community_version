<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- DEC-FM-003: flag products that contractors may request -->
    <record id="product_template_form_view_fm" model="ir.ui.view">
        <field name="name">product.template.form.fm.consumable</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='options']" position="inside">
                <span class="d-inline-block">
                    <field name="fm_consumable"/>
                    <label for="fm_consumable"/>
                </span>
            </xpath>
        </field>
    </record>

    <record id="product_template_search_view_fm" model="ir.ui.view">
        <field name="name">product.template.search.fm.consumable</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='filter_to_purchase']" position="after">
                <filter string="Facilities Consumables" name="filter_fm_consumable" domain="[('fm_consumable', '=', True)]"/>
            </xpath>
        </field>
    </record>
</odoo>
